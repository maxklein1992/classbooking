# Productie-image voor de frontend: Vite-build geserveerd door nginx, dat /api
# doorzet naar de backend-container. Build-context = repo-root.

FROM node:20-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY backend/package.json backend/
COPY frontend/package.json frontend/
RUN npm ci -w frontend --include-workspace-root=false
COPY frontend frontend
WORKDIR /app/frontend
# Same-origin: nginx proxyt /api naar de backend.
ENV VITE_API_URL=/api VITE_USE_MOCKS=false
RUN npm run build

FROM nginx:1.27-alpine
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/frontend/dist /usr/share/nginx/html
EXPOSE 80
