generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  TRAINER
}

enum Sport {
  BOXING
  FOOTVOLLEY
  YOGA
  HIIT
  SPINNING
  OTHER
}

// Optioneel: ontbreekt (null) betekent "alle niveaus" (geen indicatie
// vereist), zodat bestaande trainingen geen migratieprobleem opleveren.
enum Level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

model User {
  id             String           @id @default(uuid())
  email          String           @unique
  passwordHash   String
  name           String
  avatarUrl      String?
  role           Role             @default(USER)
  teamMembers    String[]         @default([])
  trainings      Training[]       @relation("TrainerTrainings")
  trainingSeries TrainingSeries[] @relation("TrainerTrainingSeries")
  bookings       Booking[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model Training {
  id                 String          @id @default(uuid())
  title              String
  description        String
  sport              Sport
  level              Level?
  startTime          DateTime
  endTime            DateTime
  location           String
  city               String
  neighborhood       String?
  postalCode         String?
  capacity           Int
  price              Float           @default(0)
  freeTrialAvailable Boolean         @default(false)
  trainer            User            @relation("TrainerTrainings", fields: [trainerId], references: [id], onDelete: Cascade)
  trainerId          String
  series             TrainingSeries? @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  seriesId           String?
  bookings           Booking[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([startTime])
  @@index([sport])
  @@index([level])
  @@index([city])
  @@index([seriesId])
}

// Herhaalregel voor een reeks trainingen ("herhalende training"). Bij aanmaken
// worden hieruit losse Training-rijen gegenereerd (elk gewoon los boekbaar,
// zie Training.seriesId). Dit model bewaart alleen de regel zelf, niet de
// losse sessies.
model TrainingSeries {
  id                 String     @id @default(uuid())
  title              String
  description        String
  sport              Sport
  location           String
  city               String
  neighborhood       String?
  postalCode         String?
  capacity           Int
  price              Float      @default(0)
  freeTrialAvailable Boolean    @default(false)
  // Dagen van de week waarop een sessie plaatsvindt (0=zondag .. 6=zaterdag,
  // zie Date.getDay()).
  daysOfWeek         Int[]
  // Tijdstip van de dag, los van een specifieke datum, formaat "HH:mm".
  startTime          String
  endTime            String
  // Periode waarbinnen sessies gegenereerd worden.
  activeFrom         DateTime
  activeUntil        DateTime
  trainer            User       @relation("TrainerTrainingSeries", fields: [trainerId], references: [id], onDelete: Cascade)
  trainerId          String
  trainings          Training[]
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}

model Booking {
  id         String        @id @default(uuid())
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  training   Training      @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  trainingId String
  status     BookingStatus @default(CONFIRMED)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([userId, trainingId])
  @@index([trainingId])
}
